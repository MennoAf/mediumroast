---
// index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import TerminalTypewriter from '../components/TerminalTypewriter.astro';
---

<BaseLayout>
  <section class="hero">
    <div class="container">
      <div class="hero-content">
        <span class="hero-greeting">01. Hello, I am</span>
        <h1>Jason Bauman.</h1>
        <h2>Technical Director & Maker.</h2>

        <TerminalTypewriter />

        <div class="cta-group">
          <a href="/work" class="btn btn-primary">View Work</a>
          <a href="/blog" class="btn">Read Thoughts</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
