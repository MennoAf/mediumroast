---
// BlogPostLayout.astro
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  summary: string;
  date: string;
  reading_time?: number;
  tags?: string[];
  type?: string;
  hasMermaid?: boolean;
}

const {
  title,
  summary,
  date,
  reading_time = 5,
  tags = [],
  type = "Thought",
  hasMermaid = true,
} = Astro.props;

const pageTitle = `${title} | _mediumroast`;
const currentUrl = Astro.url.href;
const encodedTitle = encodeURIComponent(title);
const encodedUrl = encodeURIComponent(currentUrl);
---

<BaseLayout title={pageTitle} description={summary} canonicalURL={currentUrl}>
  <div class="article-wrapper">
    <!-- Breadcrumb Navigation -->
    <nav aria-label="Breadcrumb" class="article-breadcrumb">
      <div class="breadcrumb-container">
        <a href="/" class="crumb-link">Home</a>
        <span class="crumb-sep">&rsaquo;</span>
        <a href="/blog" class="crumb-link">Thoughts</a>
        <span class="crumb-sep">&rsaquo;</span>
        <span class="crumb-current">{title}</span>
      </div>
    </nav>

    <!-- Header Section (Blends into background) -->
    <header class="article-header">
      <div class="eyebrow">
        <a href="/blog" class="eyebrow-tag">Thoughts</a>
        <span class="eyebrow-sep">&rsaquo;</span>
        <span class="eyebrow-type">{type}</span>
      </div>

      <h1 class="article-title">{title}</h1>

      {summary && (
        <p class="article-lead">{summary}</p>
      )}

      <div class="article-meta-row">
        <div class="meta-left">
          <span class="meta-author">Jason Bauman</span>
          <span class="meta-dot">&middot;</span>
          <time class="meta-date">{date}</time>
          <span class="meta-dot">&middot;</span>
          <span class="meta-reading">{reading_time} min read</span>
        </div>
        {tags.length > 0 && (
          <div class="meta-tags">
            {tags.map((tag) => (
              <a href={`/tags/${encodeURIComponent(tag)}`} class="tag-pill">
                #{tag}
              </a>
            ))}
          </div>
        )}
      </div>
    </header>

    <!-- Article Content (Prose) -->
    <article class="prose-content">
      <slot />
    </article>

    <!-- Article Footer & Social Share -->
    <footer class="article-footer">
      <div class="share-box">
        <span class="share-label">Share this post</span>
        <div class="share-links">
          <a
            href={`https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`}
            target="_blank"
            rel="noopener noreferrer"
            class="share-btn"
            title="Share on X / Twitter"
          >
            <svg width="15" height="15" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
            </svg>
            <span>Twitter</span>
          </a>

          <a
            href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`}
            target="_blank"
            rel="noopener noreferrer"
            class="share-btn"
            title="Share on LinkedIn"
          >
            <svg width="15" height="15" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
            </svg>
            <span>LinkedIn</span>
          </a>
        </div>
      </div>

      <div class="back-to-thoughts">
        <a href="/blog" class="back-btn">&larr; Back to all thoughts</a>
      </div>
    </footer>
  </div>

  <!-- Mermaid Support -->
  {hasMermaid && (
    <script type="module" is:inline>
      import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs';
      const isDark = document.documentElement.getAttribute('data-theme') !== 'light';
      mermaid.initialize({ startOnLoad: true, theme: isDark ? 'dark' : 'default' });
    </script>
  )}

  <!-- GitHub-style Callout Formatter -->
  <script is:inline>
    function formatCallouts() {
      const bqs = document.querySelectorAll('.prose-content blockquote');
      const icons = {
        NOTE: { icon: 'ℹ️', label: 'NOTE', color: '#4cc9f0' },
        TIP: { icon: '💡', label: 'TIP', color: 'var(--accent-color)' },
        IMPORTANT: { icon: '❗', label: 'IMPORTANT', color: '#ff7043' },
        WARNING: { icon: '⚠️', label: 'WARNING', color: '#ff5252' },
        CAUTION: { icon: '🛑', label: 'CAUTION', color: '#ff1744' }
      };

      bqs.forEach((bq) => {
        const p = bq.querySelector('p');
        if (!p) return;
        const text = p.innerHTML;
        const match = text.match(/^\[!(NOTE|TIP|IMPORTANT|WARNING|CAUTION)\]\s*(<br>|\n)?(.*)/is);
        if (match) {
          const type = match[1].toUpperCase();
          const info = icons[type] || icons.NOTE;
          p.innerHTML = match[3];
          bq.classList.add('callout');
          bq.style.borderLeftColor = info.color;
          bq.style.fontStyle = 'normal';

          const titleDiv = document.createElement('div');
          titleDiv.className = 'callout-title';
          titleDiv.style.color = info.color;
          titleDiv.innerHTML = `<span style="font-style: normal;">${info.icon}</span> <span>${info.label}</span>`;
          bq.insertBefore(titleDiv, p);
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', formatCallouts);
    } else {
      formatCallouts();
    }
    document.addEventListener('astro:page-load', formatCallouts);
  </script>
</BaseLayout>

<style>
  .article-wrapper {
    max-width: 820px;
    margin: 0 auto;
    padding: 100px 24px 80px 24px;
    background: transparent;
  }

  /* Breadcrumbs */
  .article-breadcrumb {
    margin-bottom: 2rem;
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .breadcrumb-container {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .crumb-link {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .crumb-link:hover {
    color: var(--accent-color);
  }

  .crumb-sep {
    color: var(--accent-dim);
    opacity: 0.8;
  }

  .crumb-current {
    color: var(--text-primary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 320px;
  }

  /* Header */
  .article-header {
    margin-bottom: 3.5rem;
  }

  .eyebrow {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    color: var(--accent-color);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .eyebrow-link {
    color: var(--accent-color);
    text-decoration: none;
  }

  .eyebrow-link:hover {
    text-decoration: underline;
  }

  .eyebrow-sep {
    opacity: 0.5;
  }

  .eyebrow-type {
    color: var(--text-secondary);
  }

  .article-title {
    font-size: clamp(2.2rem, 4.5vw, 3.2rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin: 0 0 1.5rem 0;
  }

  .article-lead {
    font-size: 1.25rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin: 0 0 2rem 0;
  }

  .article-meta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 1.25rem;
    border-top: 1px solid var(--accent-dim);
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .meta-left {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .meta-author {
    color: var(--text-primary);
    font-weight: 600;
  }

  .meta-dot {
    opacity: 0.4;
  }

  .meta-tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .tag-pill {
    font-family: var(--font-heading);
    font-size: 0.78rem;
    color: var(--accent-color);
    background: var(--accent-dim);
    padding: 3px 9px;
    border-radius: 4px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .tag-pill:hover {
    background: var(--accent-color);
    color: var(--bg-color);
  }

  /* Prose Body Styling */
  .prose-content {
    font-size: 1.125rem;
    line-height: 1.85;
    color: var(--text-secondary);
  }

  .prose-content :global(p) {
    margin-bottom: 1.65rem;
  }

  .prose-content :global(strong),
  .prose-content :global(b) {
    color: var(--text-primary);
    font-weight: 600;
  }

  .prose-content :global(h2) {
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.25;
    margin-top: 3.5rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--accent-dim);
    letter-spacing: -0.015em;
  }

  .prose-content :global(h3) {
    font-family: var(--font-heading);
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.3;
    margin-top: 2.75rem;
    margin-bottom: 1rem;
    letter-spacing: -0.01em;
  }

  .prose-content :global(h4) {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .prose-content :global(ul),
  .prose-content :global(ol) {
    margin: 0 0 1.65rem 0;
    padding-left: 1.75rem;
  }

  .prose-content :global(li) {
    margin-bottom: 0.65rem;
    padding-left: 0.25rem;
  }

  .prose-content :global(a) {
    color: var(--accent-color);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    transition: opacity 0.2s ease;
  }

  .prose-content :global(a:hover) {
    opacity: 0.85;
    text-decoration-thickness: 2px;
  }

  .prose-content :global(blockquote) {
    margin: 2.5rem 0;
    padding: 1.25rem 1.75rem;
    border-left: 3px solid var(--accent-color);
    background: var(--accent-dim);
    border-radius: 0 8px 8px 0;
    color: var(--text-primary);
    font-style: italic;
  }

  .prose-content :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .prose-content :global(code) {
    font-family: var(--font-heading);
    font-size: 0.88em;
    background: var(--accent-dim);
    padding: 0.2em 0.45em;
    border-radius: 4px;
    color: var(--text-primary);
  }

  .prose-content :global(pre) {
    margin: 2.5rem 0;
    padding: 1.35rem 1.65rem;
    background: var(--code-bg);
    border: 1px solid var(--code-border);
    border-radius: 8px;
    overflow-x: auto;
    font-family: var(--font-heading);
    font-size: 0.92rem;
    line-height: 1.65;
  }

  .prose-content :global(pre code) {
    background: transparent;
    padding: 0;
    border-radius: 0;
    color: inherit;
    font-size: inherit;
  }

  .prose-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 2.5rem 0;
    font-size: 0.95rem;
  }

  .prose-content :global(th) {
    text-align: left;
    padding: 12px 16px;
    border-bottom: 2px solid var(--accent-color);
    color: var(--text-primary);
    font-family: var(--font-heading);
    background: var(--accent-dim);
    font-weight: 600;
  }

  .prose-content :global(td) {
    padding: 12px 16px;
    border-bottom: 1px solid var(--accent-dim);
    color: var(--text-secondary);
  }

  .prose-content :global(hr) {
    border: none;
    border-top: 1px solid var(--accent-dim);
    margin: 3.5rem 0;
  }

  /* Callout styling matching industrial/coffee aesthetic */
  .prose-content :global(.callout) {
    margin: 2.2rem 0;
    padding: 1.25rem 1.5rem;
    border-radius: 6px;
    border-left: 4px solid var(--accent-color);
    background: var(--accent-dim);
  }

  .prose-content :global(.callout-title) {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 700;
    margin-bottom: 0.6rem;
    color: var(--text-primary);
    letter-spacing: 0.05em;
  }

  .prose-content :global(.callout-content) {
    font-size: 1.02rem;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .prose-content :global(.callout-content p:last-child) {
    margin-bottom: 0;
  }

  /* Footer */
  .article-footer {
    margin-top: 4.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--accent-dim);
  }

  .share-box {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 2.5rem;
  }

  .share-label {
    font-family: var(--font-heading);
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .share-links {
    display: flex;
    gap: 12px;
  }

  .share-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    font-family: var(--font-heading);
    font-size: 0.85rem;
    border: 1px solid var(--accent-dim);
    color: var(--text-secondary);
    border-radius: 4px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .share-btn:hover {
    border-color: var(--accent-color);
    color: var(--accent-color);
    background: var(--accent-dim);
  }

  .back-to-thoughts {
    text-align: center;
    margin-top: 1rem;
  }

  .back-btn {
    display: inline-block;
    padding: 12px 24px;
    font-family: var(--font-heading);
    font-size: 0.9rem;
    border: 1px solid var(--accent-color);
    color: var(--accent-color);
    text-decoration: none;
    border-radius: 4px;
    transition: all 0.2s ease;
  }

  .back-btn:hover {
    background: var(--accent-color);
    color: var(--bg-color);
  }
</style>
