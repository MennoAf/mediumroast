---
// BaseLayout.astro
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalURL?: string;
}

const {
  title = "Jason Bauman | Technical Director & Maker | _mediumroast",
  description = "Technical Director & Maker specializing in SEO Strategy, Data Engineering, and AI Automation.",
  canonicalURL = Astro.url.href,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=coffee" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=coffee" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=coffee" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=coffee" />
  <link rel="shortcut icon" href="/favicon.ico?v=coffee" />
  <link rel="alternate" type="application/rss+xml" title="_mediumroast" href="/rss.xml" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;700&family=Inter:wght@400;600;700&display=swap"
    rel="stylesheet"
  />

  <!-- Anti-FOUC Inline Theme Script -->
  <script is:inline>
    (function () {
      const savedTheme = localStorage.getItem('theme');
      if (savedTheme) {
        document.documentElement.setAttribute('data-theme', savedTheme);
      } else {
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.setAttribute('data-theme', prefersDark ? 'dark' : 'dark');
      }
    })();
  </script>

  <!-- Analytics -->
  <script defer data-domain="mediumroast.dev" src="https://plausible.io/js/script.js"></script>
</head>
<body>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
</body>
</html>
