---
// BlogPostCard.astro
interface Props {
  title: string;
  url: string;
  date: string;
  reading_time?: number;
  tags?: string[];
  summary: string;
}

const { title, url, date, reading_time = 5, tags = [], summary } = Astro.props;
const tagString = tags.join(' ');
---

<article class="blog-post" data-tags={tagString} style="margin-bottom: 2.5rem; padding-bottom: 2rem; border-bottom: 1px solid var(--accent-dim);">
  <h2 style="font-size: 1.5rem; margin-bottom: 0.5rem;">
    <a href={url} style="color: inherit; text-decoration: none;">{title}</a>
  </h2>
  <div class="post-meta" style="display: flex; gap: 15px; font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 1rem; align-items: center; flex-wrap: wrap;">
    <span class="post-date">{date}</span>
    <span>&bull;</span>
    <span class="post-reading-time">{reading_time} min read</span>
    {tags.length > 0 && (
      <>
        <span>&bull;</span>
        <div class="post-tags" style="display: flex; gap: 6px;">
          {tags.map((tag) => (
            <a href={`/tags/${encodeURIComponent(tag)}`} style="color: var(--accent-color); font-size: 0.8rem; font-family: var(--font-heading); text-decoration: none;">
              #{tag}
            </a>
          ))}
        </div>
      </>
    )}
  </div>
  <div class="post-content">
    <p style="color: var(--text-secondary); line-height: 1.6; margin-bottom: 1rem;">
      {summary}
    </p>
    <a href={url} class="read-more" style="color: var(--accent-color); font-weight: 600; font-family: var(--font-heading); text-decoration: none; display: inline-block;">
      Read Article &rarr;
    </a>
  </div>
</article>
