---
// ProjectCard.astro
interface Props {
  title: string;
  type: string;
  date: string;
  summary: string;
  url: string;
  tags?: string[];
}

const { title, type, date, summary, url, tags = [] } = Astro.props;
---

<div class="project-card code-editor" style="margin-bottom: 2rem;">
  <div class="editor-header" style="display: flex; align-items: center;">
    <span class="dot red"></span>
    <span class="dot yellow"></span>
    <span class="dot green"></span>
    <span class="filename" style="margin-left: 10px; font-size: 0.85rem; font-family: var(--font-heading);">{type}</span>
    <span style="margin-left: auto; font-size: 0.85rem; color: var(--text-secondary);">{date}</span>
  </div>
  <div class="editor-content" style="padding: 1.5rem; background: var(--card-bg);">
    <h2 style="margin-top: 0; margin-bottom: 1rem;">
      <a href={url} style="color: inherit; text-decoration: none;">{title}</a>
    </h2>
    <p style="color: var(--text-secondary); line-height: 1.6; margin-bottom: 1.5rem;">{summary}</p>
    {tags.length > 0 && (
      <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 1rem;">
        {tags.map((tag) => (
          <span style="font-size: 0.75rem; font-family: var(--font-heading); color: var(--text-secondary); background: var(--accent-dim); padding: 2px 8px; border-radius: 3px;">
            #{tag}
          </span>
        ))}
      </div>
    )}
    <a href={url} class="read-more" style="color: var(--accent-color); text-decoration: none; font-weight: 600; font-family: var(--font-heading); display: inline-block;">
      View Details &rarr;
    </a>
  </div>
</div>
