---
// Footer.astro
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-info">
      <span class="footer-copy">
        &copy; {year} Jason Bauman
      </span>
      <div class="footer-stack">
        Built with <span class="accent-text">Astro 5</span>, TypeScript, and a lot of Coffee
      </div>
    </div>

    <div class="footer-social">
      <a href="mailto:jason@mediumroast.dev" aria-label="Email" class="social-link">
        <svg viewBox="0 0 24 24" fill="currentColor">
          <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z" />
        </svg>
      </a>
      
      <a href="https://github.com/mennoaf" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="social-link">
        <svg viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
      </a>

      <a href="https://www.linkedin.com/in/jasonlbauman/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="social-link">
        <svg viewBox="0 0 24 24" fill="currentColor">
          <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
        </svg>
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--card-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    padding: 36px 0;
    border-top: 1px solid var(--card-border);
    margin-top: auto;
    transition: background-color 0.25s ease, border-color 0.25s ease;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .footer-copy {
    font-family: var(--font-heading);
    color: var(--text-primary);
    font-size: 0.88rem;
    font-weight: 600;
  }

  .footer-stack {
    color: var(--text-secondary);
    font-size: 0.8rem;
    margin-top: 0.25rem;
  }

  .accent-text {
    color: var(--accent-color);
    font-weight: 600;
  }

  .footer-social {
    display: flex;
    gap: 1.25rem;
    align-items: center;
  }

  .social-link {
    color: var(--text-secondary);
    width: 22px;
    height: 22px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .social-link svg {
    width: 100%;
    height: 100%;
  }

  .social-link:hover {
    color: var(--accent-color);
    transform: translateY(-2px);
  }
</style>
